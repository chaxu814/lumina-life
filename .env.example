# ============================================================
# Lumina Life 1.0 (正式版) — 环境配置
# 复制此文件为 .env 并填入你的配置
# ============================================================
#
# 🔧 只需配置一个供应商就能用，Lumina 自动检测
#   默认使用 LM Studio（本地，无需 API Key）
#   如需云端，推荐 DeepSeek（低价+中文好）
#
# 使用方式:
#   1. 选择一个供应商
#   2. 填上 apiKey（LM Studio 本地不需要）
#   3. 启动 Lumina
# ============================================================

# ── 通用默认 API Key ──────────────────────────────
# 如果你所有供应商用同一个 key（如硅基流动），在这里填一次即可
# LUMINA_DEFAULT_API_KEY=sk-你的key

# ── 默认使用的供应商 ─────────────────────────────
# 值: deepseek | qwen | openai | zhipu | siliconflow | lmstudio | ollama
# 默认使用 LM Studio（本地 127.0.0.1:1234，免 API Key）
LUMINA_DEFAULT_PROVIDER=lmstudio

# ============================================================
# 📡 云端供应商 (7个全配，只需填你用的)
# ============================================================

# ── ① DeepSeek (⭐ 推荐: 超低价 + 中文好 + coding强) ──
# 获取 Key: https://platform.deepseek.com/api_keys
# 模型推荐: deepseek-chat (快) / deepseek-reasoner (深度推理)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=sk-你的key

# ── ② 通义千问 — 阿里云百炼 (10M上下文, 256K+) ──
# 获取 Key: https://dashscope.console.aliyun.com/apiKey
# 模型推荐: qwen-plus (性价比) / qwen-max (最强) / qwen-long (超长上下文)
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=sk-你的key

# ── ③ OpenAI ─────────────────────────────────
# 获取 Key: https://platform.openai.com/api-keys
# 模型推荐: gpt-4o / gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-你的key

# ── ④ 智谱 GLM ───────────────────────────────
# 获取 Key: https://open.bigmodel.cn/usercenter/apikeys
# 模型推荐: glm-4-plus / glm-4-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_API_KEY=你的key

# ── ⑤ 硅基流动 (多模型聚合, 低价) ───────────────
# 获取 Key: https://cloud.siliconflow.cn/account/ak
# 模型推荐: Qwen/Qwen3-235B-A22B / deepseek-ai/DeepSeek-V3
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_API_KEY=sk-你的key

# ============================================================
# 🏠 本地供应商 (免费 / 隐私 / 离线)
# ============================================================

# ── ⑥ LM Studio (⭐ 推荐本地: 下载即用, 有GUI) ──
# 下载: https://lmstudio.ai/
# 使用方法: 下载模型 → 启动 Local Server → 端口默认 1234
# 模型推荐: qwen3.6-27b-instruct (中文好) / llama-3.1-8b (轻量)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=

# ── ⑦ Ollama (轻量 CLI 本地) ──────────────────
# 下载: https://ollama.com/
# 使用方法: ollama pull qwen3:14b && ollama serve
# 模型推荐: qwen3:14b / deepseek-r1:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=

# ============================================================
# ⚙️ 高级配置 (可选)
# ============================================================
# LUMINA_LLM_TIMEOUT=600         # LLM 超时秒数 (默认 300)
# LUMINA_LLM_RETRIES=3           # 超时后自动重试次数 (默认 2)
# LUMINA_LLM_MAX_CONCURRENT=10   # 最大并发 LLM 调用数
# LUMINA_LLM_MAX_CONTEXT_TOKENS=256000  # 上下文窗口
# LUMINA_DELEGATION_TIMEOUT_MS=600000   # Agent 委托超时 (毫秒)

# ============================================================
# 🎨 VLM 配置 (Computer Use / 屏幕感知, 可选)
# ============================================================
# LUMINA_VLM_BASE_URL=https://api.moonshot.cn/v1
# LUMINA_VLM_MODEL=kimi-k2-0905-preview
# LUMINA_VLM_API_KEY=sk-你的key

# ============================================================
# 🔍 Embedding 服务 (向量语义检索, 可选)
# ============================================================
# 方式 1: Python 本地服务 (推荐)
#   pip install sentence-transformers
#   python python/embedding_server.py --port 18923
# LUMINA_EMBEDDING_URL=http://127.0.0.1:18923
#
# 方式 2: Ollama
#   ollama pull nomic-embed-text
# LUMINA_EMBEDDING_URL=http://127.0.0.1:11434

# ============================================================
# 🎮 Minecraft 游戏集成 (可选, 默认关闭)
# ============================================================
# 双路线：
#   - visual: 视觉路线（截图 + VLM 识别 + 键鼠操作），零配置，依赖 VLM
#   - bot:    程序化路线（Mineflayer bot），需自建/指定 MC 服务器，更可靠
# LUMINA_GAME_ENABLED=false
# LUMINA_GAME_ROUTE=auto            # auto | visual | bot
# LUMINA_GAME_WINDOW_TITLE=Minecraft
#
# 程序化路线（可选，配置后 auto 自动走 bot）：
# LUMINA_MINECRAFT_HOST=127.0.0.1
# LUMINA_MINECRAFT_PORT=25565
# LUMINA_MINECRAFT_USERNAME=lumina_bot
# LUMINA_MINECRAFT_VERSION=1.20.4
