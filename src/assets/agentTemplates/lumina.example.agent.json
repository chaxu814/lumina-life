{
  "//": "Lumina 角色配置脱敏样例（boss / 唯一对用户接口）。复制为 agents/lumina/agent.json 后按需填写；真实 agents/ 目录已被 .gitignore 忽略，不会入库。",
  "id": "lumina",
  "name": "Lumina",
  "role": "boss",
  "enabled": true,
  "llm": {
    "provider": "lmstudio",
    "model": "YOUR_MODEL_NAME",
    "endpoint": "http://127.0.0.1:1234/v1",
    "apiKey": "YOUR_API_KEY_OR_LEAVE_EMPTY_FOR_LOCAL",
    "maxContextTokens": 131072,
    "timeout": 600,
    "temperature": 0.7,
    "topP": 0.9
  },
  "tools": {
    "whitelist": [],
    "blacklist": [],
    "approvalLevel": "auto"
  },
  "social": {
    "ttsVoice": "zh-CN-XiaoxiaoNeural",
    "mood": 0.3,
    "energy": 0.7,
    "affinity": 0.5
  },
  "paths": {
    "chats": "chats.json",
    "jobs": "jobs.json",
    "memory": "memory",
    "dialog": "dialog"
  }
}
