{
  "//": "Yak 角色配置脱敏样例（worker / 数据分析，后台隐身）。复制为 agents/yak/agent.json 后按需填写。",
  "id": "yak",
  "name": "Yak",
  "role": "worker",
  "enabled": true,
  "llm": {
    "provider": "lmstudio",
    "model": "YOUR_MODEL_NAME",
    "endpoint": "http://127.0.0.1:1234/v1",
    "apiKey": "YOUR_API_KEY_OR_LEAVE_EMPTY_FOR_LOCAL",
    "maxContextTokens": 131072,
    "timeout": 600,
    "temperature": 0.3,
    "topP": 0.9
  },
  "tools": {
    "whitelist": [
      "write_code",
      "debug",
      "explain_code"
    ],
    "blacklist": [],
    "approvalLevel": "none"
  },
  "social": {
    "ttsVoice": "zh-CN-YunjianNeural",
    "mood": 0.5,
    "energy": 0.8,
    "affinity": 0.6
  },
  "paths": {
    "chats": "chats.json",
    "jobs": "jobs.json",
    "memory": "memory",
    "dialog": "dialog"
  }
}
