{
  "//": "热茶 Recha 角色配置脱敏样例（worker / 代码审查，后台隐身）。复制为 agents/recha/agent.json 后按需填写。",
  "id": "recha",
  "name": "热茶",
  "role": "worker",
  "enabled": true,
  "llm": {
    "provider": "lmstudio",
    "model": "YOUR_MODEL_NAME",
    "endpoint": "http://127.0.0.1:1234/v1",
    "apiKey": "YOUR_API_KEY_OR_LEAVE_EMPTY_FOR_LOCAL",
    "maxContextTokens": 131072,
    "timeout": 600,
    "temperature": 0.2,
    "topP": 0.9
  },
  "tools": {
    "whitelist": [
      "review_code",
      "find_bug",
      "risk_assessment"
    ],
    "blacklist": [],
    "approvalLevel": "none"
  },
  "social": {
    "ttsVoice": "zh-CN-YunxiNeural",
    "mood": 0.4,
    "energy": 0.6,
    "affinity": 0.7
  },
  "paths": {
    "chats": "chats.json",
    "jobs": "jobs.json",
    "memory": "memory",
    "dialog": "dialog"
  }
}
