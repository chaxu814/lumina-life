/docs/internal/
# 本地归档（评测报告 / 内部交付说明 / 测试备份等已忽略文件的归集地；整目录不进仓库）
/archive/

# ── 测试运行时产生的临时备份 ─────────────────────────────────
# memoryEvidence 相关用例会往仓库根目录写
# memory-evidence-test-<n>.json.bak.<ISO时间戳> —— 它们是测试 fixture 的
# 自动备份，不含任何信息，却因为某次误提交进了版本库，把仓库根目录弄得很脏。
# 现在取消跟踪 + 加入 ignore；磁盘上的旧文件可以随时手动删。
/memory-evidence-test-*.json
/memory-evidence-test-*.json.bak.*
*.json.bak.*
/.cowork-temp/

# 运行时探针 / 状态文件（每次运行都会重新生成）
/.doctor_probe
/async-tasks.json

# ── VitePress build output (regenerated on deploy) ──
docs/.vitepress/dist/
docs/.vitepress/cache/


# 运行时状态
.lumina-recovery.json

# 发布卫生：评测过程的调试截图不进仓库（约 2.2MB）
docs/gaming-autoplay-evidence/

# ── Live2D 示例模型：授权限制，不随仓库分发 ─────────────────
# Cubism 官方示例模型「Mao」受 Live2D Cubism SDK 再分发条款约束，
# 公开仓库属于「再分发」。请从 Live2D 官方渠道自行获取后在应用内导入。
# 保底形象是无外部素材的程序化小猫（Cat），永远可用。
/electron/pet/assets/Mao/

# ── Agent 内部脚手架，不属于产品文档 ────────────────────────
/knowledge/
/stt-server/
# 用户会话数据（隐私）— 防止 git add -A 误提交
/sessions/

# ── 精灵表 UGC 资产：必须入库 ─────────────────────────────
# 上面的 *.png 是为了挡住测试截图与运行期产物；
# 但 examples/sprites/ 是**产品资产**（社区创作的入口与模板），
# 不入库的话新用户克隆下来就没有起步文件，UGC 飞轮转不起来。
!examples/sprites/**/*.png
!docs/images/**/*.png
!resources/*.png

# 本地打包日志（Tee 临时输出）
/pack-win-log*.txt

# ── 桌宠渲染器生成物（npm run build:pet-life/voice/vrm/mmd 重建，勿入库）──
#   源码在 electron/pet/life|lifeSpeech|vrm|mmd/，产物由 prebuild 生成；
#   入库会造成「改了源码生成物不更新」与仓库体积膨胀（2.5MB）。
/electron/pet/assets/pet-life.js
/electron/pet/assets/pet-voice.js
/electron/pet/assets/pet-vrm.js
/electron/pet/assets/pet-mmd.js
